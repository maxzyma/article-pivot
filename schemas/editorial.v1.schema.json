{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maxzyma/article-pivot/schemas/editorial.v1.schema.json",
  "title": "Editorial Overlay",
  "type": "object",
  "required": ["locale", "source_revision", "profile", "category", "key_points", "glossary"],
  "properties": {
    "locale": {"type": "string", "minLength": 1},
    "source_revision": {"type": "string", "minLength": 1},
    "profile": {"const": "bilingual-zh-first.v1"},
    "category": {"type": "string", "minLength": 1},
    "source_label": {"type": "string"},
    "key_points": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "glossary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["term", "translation"],
        "properties": {
          "term": {"type": "string", "minLength": 1},
          "translation": {"type": "string", "minLength": 1},
          "note": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
